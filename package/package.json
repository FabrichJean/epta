{
  "name": "@fabrich/epta",
  "version": "1.0.4",
  "description": "TypeScript client for EPTA Auth API",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
